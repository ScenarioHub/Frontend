{
  "[tailwindcss]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true,
  },
  "code-runner.executorMap": {
    "javascript": "node",
    "typescript": "node",
  },
  "cSpell.ignoreRegExpList": [
    "\\/.*\\/",
    "(['\"])[a-zA-Z0-9~@#$-_./]{30,}\\1",
  ],
  "cSpell.words": [
    "arrayable",
    "asyncify",
    "bezier",
    "bivariance",
    "bivariant",
    "booleanish",
    "colada",
    "consolas",
    "coverflow",
    "defu",
    "describedby",
    "ENDLIST",
    "enterkeyhint",
    "GLTF",
    "hookable",
    "hoverable",
    "iconify",
    "inputmode",
    "jsonifiable",
    "jsonify",
    "kbds",
    "labelable",
    "labelledby",
    "lucide",
    "maxlength",
    "minmax",
    "nitropack",
    "nowrap",
    "nums",
    "nuxi",
    "nuxt",
    "nuxtignore",
    "nuxtjs",
    "nuxtrc",
    "ofetch",
    "oklab",
    "pinia",
    "promisable",
    "quicktime",
    "recalc",
    "reka",
    "rerere",
    "shadcn",
    "splitted",
    "stepbar",
    "stringbool",
    "suspensible",
    "topbar",
    "unimport",
    "unjs",
    "unocss",
    "unovue",
    "unref",
    "vaul",
    "vite",
    "vnode",
    "vuejs",
    "vueuse"
  ],
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "always"
  },
  "eslint.validate": ["javascript", "typescript", "vue"],
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "eslint.rules.customizations": [
    {
      "rule": "*",
      "fixable": true,
      "severity": "warn",
    },
    {
      "rule": "@stylistic/*",
      "fixable": true,
      "severity": "off",
    },
  ],
  "files.associations": {
    ".nuxtignore": "ignore",
    "*.css": "tailwindcss",
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.readonlyInclude": {
    ".nuxt/**": true,
    ".output/**": true,
    ".vscode/iconify/*": true,
    "**/*.readonly.*": true,
    "node_modules/**": true,
    "pnpm-lock.yaml": true
  },
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    ".github/**": true,
    ".nuxt/**": true,
    ".output/**": true,
    ".vscode/**": true,
    "node_modules/**": true,
  },
  "iconify.customCollectionJsonPaths": [
    ".vscode/iconify/fd.json",
  ],
  "iconify.delimiters": [
    ":",
  ],
  "material-icon-theme.activeIconPack": "vue",
  "material-icon-theme.files.associations": {
    ".vscode/extensions.json": "vscode",
    ".vscode/settings.json": "vscode",
    "app/app.config.ts": "tune",
    "app/router.options.ts": "routing",
    "*.tsx": "vue",
    "*.tw.css": "tailwindcss",
  },
  "material-icon-theme.folders.associations": {
    "composables": "vue-directives",
    "postcss": "css",
    "stores": "store",
    "unocss": "css",
  },
  "search.exclude": {
    // 디렉토리
    "**/.github": true,
    "**/.nuxt": true,
    "**/.output": true,
    "**/.vscode": true,
    "**/__screenshots__": true,
    "**/node_modules": true,
    "**/dist": true,
    // 파일
    "**/.editorconfig": true,
    "**/.env": true,
    "**/.env.*": true,
    "**/.gitignore": true,
    "**/.npmrc": true,
    "**/eslint.config.*": true,
    "**/package.json": true,
    "**/pnpm-lock.yaml": true,
    "**/pnpm-workspace.yaml": true,
    "**/tsconfig.json": true,
    "**/vitest.config.ts": true,
    "**/*.json": true,
    "**/*.svg": true,
    "**/*.yaml": true,
  },
  "search.useIgnoreFiles": true,
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "class:list",
    // Vue Transition
    "enterActiveClass",
    "enter-active-class",
    "enterFromClass",
    "enter-from-class",
    "enterToClass",
    "enter-to-class",
    "leaveActiveClass",
    "leave-active-class",
    "leaveFromClass",
    "leave-from-class",
    "leaveToClass",
    "leave-to-class",
    // Vue Router Link
    "activeClass",
    "active-class",
    "exactActiveClass",
    "exact-active-class",
  ],
  "tailwindCSS.classFunctions": [
    "tw",
  ],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "invalid.illegal.character-not-allowed-here.html",
                "settings": {
                    "foreground": "#808080"
                }
            }
        ]
    },
}
